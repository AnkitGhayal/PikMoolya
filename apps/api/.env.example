# Server Port (Render sets this automatically via $PORT)
PORT=3000

# Database Connection (Neon PostgreSQL)
# Format: postgres://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/pikmoolya?sslmode=require

# Alternatively, configure discrete connection parameters for local development:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_local_password
DB_NAME=pikmoolya
DB_SSL=false

# Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# External AI Service URL (Render Web Service)
AI_SERVICE_URL=https://pikmoolya-ai.onrender.com

# CORS Configuration (comma-separated list of allowed origins, or leave empty for all)
CORS_ORIGIN=https://pikmoolya.vercel.app
